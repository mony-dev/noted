generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model CategoryType {
  id       String     @id @default(uuid())
  name     String     @unique
  emoji    String
  categories Category[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id         String         @id @default(uuid())
  name       String         @unique
  typeId     String
  type       CategoryType   @relation(fields: [typeId], references: [id])
  tasks      Task[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  priority    Priority 
  isComplete  Boolean  @default(false)
  startTime   String?
  endTime     String?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
